# FlyMasar environment configuration.
#
# Copy this file to ".env" and fill in the real values. The app reads ALL of
# these via getenv(). Place the real ".env" EITHER:
#   - one level ABOVE public_html  (recommended — outside the deploy target,
#     so an auto-deploy never wipes it), or
#   - inside public_html.
# index.php looks in the parent directory first, then public_html.
#
# Do NOT commit the real .env to git (it is git-ignored).

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_DEBUG=0
# 64 hex characters. Used to derive at-rest encryption keys (passenger PII,
# documents). MUST stay constant — changing it makes existing encrypted data
# unreadable. Generate once with: php -r "echo bin2hex(random_bytes(32));"
APP_MASTER_KEY=

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u205378580_Flymasar
DB_USER=
DB_PASSWORD=

# ── Duffel (flights) ─────────────────────────────────────────────────────────
DUFFEL_API_KEY=
DUFFEL_WEBHOOK_SECRET=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2

# ── Stripe (payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=GBP

# ── RateHawk (hotels) ────────────────────────────────────────────────────────
RATEHAWK_KEY_ID=
RATEHAWK_API_KEY=
RATEHAWK_BASE_URL=https://api.worldota.net/api/b2b/v3

# ── Anthropic (passport scanning — optional) ─────────────────────────────────
ANTHROPIC_API_KEY=
