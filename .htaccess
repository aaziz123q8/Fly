Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On

# ── Clean URLs ───────────────────────────────────────────────────────────────
# Show pages without the ".html" extension (e.g. /flights instead of
# /flights.html). Any real ".html" request is 301-redirected to the clean URL,
# and clean URLs are internally served from the matching ".html" file.

# 1) index.html  →  /   (home lives at the root)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# 2) any other  page.html  →  /page   (preserve the query string automatically)
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) /index (bare) → /
RewriteRule ^index/?$ / [R=301,L]

# 4) Serve the extensionless URL from its .html file (internal rewrite, no redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ /$1.html [L]

# ── API / router fallback ────────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self \"https://js.stripe.com\" \"https://pay.google.com\")"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://pay.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://pics.avs.io https://cf.bstatic.com https://*.stripe.com https://images.unsplash.com; connect-src 'self' https://api.stripe.com https://errors.stripe.com https://m.stripe.network https://pay.google.com; frame-src https://js.stripe.com https://hooks.stripe.com https://m.stripe.network https://pay.google.com; frame-ancestors 'none';"

# Enable CORS for API
Header always set Access-Control-Allow-Origin "*"
Header always set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
Header always set Access-Control-Allow-Headers "Content-Type, Authorization"

# Handle preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=204,L]

# DirectoryIndex
DirectoryIndex index.html index.php
